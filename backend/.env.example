# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Connection String (replace with your PostgreSQL credentials)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/smarterp

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# (Optional) SMTP Email Configuration (If not provided, auth controller runs in mock mode)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
